@PACKAGE_INIT@

if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/sl2cfoamxxTargets.cmake")
  message(FATAL_ERROR
    "This is not a complete installed sl2cfoam++ package. Run "
    "'cmake --install <library-build> --prefix <install-prefix>', then set "
    "CMAKE_PREFIX_PATH=<install-prefix> in your application's CMake configure. "
    "Alternatively, set sl2cfoamxx_DIR to the installed lib/cmake/sl2cfoamxx "
    "(or lib64/cmake/sl2cfoamxx) directory. Do not point it at the library's "
    "build directory.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sl2cfoamxxTargets.cmake")

check_required_components(sl2cfoamxx)
